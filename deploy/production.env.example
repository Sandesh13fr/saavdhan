# Copy to production.env outside Git, chmod 600; set domain to an owned DNS name.
SAAVDHAN_DOMAIN=
SAAVDHAN_PUBLIC_ORIGIN=https://saavdhan.example.org
SAAVDHAN_ENABLE_LLM=false
LITELLM_API_KEY=
SAAVDHAN_OPENAI_MODEL=claude-haiku
SAAVDHAN_LLM_BASE_URL=https://litellm.vision.aivar.app/v1
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a second copy of this key offline; losing it loses backup recovery.
SAAVDHAN_BACKUP_KEY=
