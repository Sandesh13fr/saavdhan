# Copy to production.env outside Git, chmod 600; set domain to an owned DNS name.
SAAVDHAN_DOMAIN=
SAAVDHAN_PUBLIC_ORIGIN=https://saavdhan.example.org
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SAAVDHAN_HASH_SALT=
# Optional read-only demo officer for the synthetic pattern map (12+ characters).
SAAVDHAN_DEMO_OFFICER_PASSWORD=
# Optional LLM via an OpenAI-compatible gateway. Offer text is sent to it when enabled.
SAAVDHAN_ENABLE_LLM=false
OPENAI_API_KEY=
SAAVDHAN_OPENAI_MODEL=
SAAVDHAN_LLM_BASE_URL=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a second copy of this key offline; losing it loses backup recovery.
SAAVDHAN_BACKUP_KEY=
