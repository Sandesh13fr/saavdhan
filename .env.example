# Optional LLM extraction sends offer text to the configured OpenAI-compatible gateway. Off by default.
SAAVDHAN_ENABLE_LLM=false
OPENAI_API_KEY=
SAAVDHAN_OPENAI_MODEL=gpt-4o-mini
# Optional trusted reverse-proxy hostname(s), comma separated. No wildcards.
SAAVDHAN_ALLOWED_HOSTS=


# Production is fail-closed: provision users with python -m backend.auth create-user.
SAAVDHAN_ENV=local
SAAVDHAN_PUBLIC_ORIGIN=
# Account sessions expire after 8 hours; passwords require at least 12 characters.

# Local OCR for image offers (Tesseract). Add hin/mar tessdata for Hindi/Marathi: eng+hin+mar
SAAVDHAN_OCR_ENABLED=false
TESSERACT_CMD=
SAAVDHAN_OCR_LANGS=eng

# LLM via any OpenAI-compatible gateway, e.g. TokenRouter:
# SAAVDHAN_LLM_BASE_URL=https://api.tokenrouter.com/v1
# SAAVDHAN_OPENAI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
SAAVDHAN_LLM_BASE_URL=
