  "narrative": {
    "northStar": "The Paper Trail",
    "rules": [
      {
        "name": "The Explicit Status Rule",
        "body": "Always pair a status color with its textual meaning.",
        "section": "colors"
      },
      {
        "name": "The Records Before Totals Rule",
        "body": "Keep the ledger and linked evidence ahead of aggregate figures in the reading order.",
        "section": "layout"
      },
      {
        "name": "Progressive disclosure",
        "body": "Keep three primary routes; show agent settings, secondary routes and history on demand. Required review controls remain visible.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do keep financial amounts aligned and source links close to their facts.",
      "Do preserve synthetic labels, unresolved states, and human review before export.",
      "Do use existing green, ivory, paper, and border roles consistently.",
      "Do retain keyboard focus and reduced-motion behavior."
    ],
    "keyCharacteristics": [
      "Deep green navigation and pale working surfaces.",
      "Crisp paper documents with nearby provenance.",
      "Compact financial records with tabular numerals.",
      "Explicit status text and restrained state colors."
    ],
    "overview": "Bakaya uses a calm green and ivory workspace to make financial records inspectable. Serif headings provide the character of a document; compact sans-serif controls and aligned amounts support careful comparison. The approved ledger-first and evidence-first experiences share this world.\n\nThe interface makes uncertainty visible through plain status labels and review controls. Synthetic examples are labeled, and human approval precedes local export. These commitments constrain the presentation of records and actions throughout the product.",
    "donts": [
      "Don't present illustrative or synthetic values as verified real claims.",
      "Don't rely on color alone to explain a status.",
      "Don't hide uncertainty behind a success treatment.",
      "Don't add decorative raster imagery to the record workspace.\r"
    ]
  }
