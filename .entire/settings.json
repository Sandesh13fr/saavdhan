{
  "enabled": true,
  "absolute_git_hook_path": true,
  "telemetry": false,
  "checkpoints": {
    "primary": {
      "type": "git-refs"
    }
  },
  "redaction": {
    "custom_redactions": {
      "crustdata_key": "cd_[A-Za-z0-9_-]{20,}",
      "gateway_key": "sk-[A-Za-z0-9_-]{16,}"
    }
  },
  "commit_linking": "always"
}
